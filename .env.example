# Copy this file to .env and fill in real values only if you want to connect
# to a live MetaTrader 5 demo account. Leave MT5_USE_MOCK=true (the default)
# to run entirely on simulated data - no account needed.

MT5_USE_MOCK=true

# Only required when MT5_USE_MOCK=false:
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
